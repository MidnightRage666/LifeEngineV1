<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="ShaderProgramm\shaderStandard_vertex.glsl" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ShaderProgramm\shaderStandard_fragment.glsl" />
